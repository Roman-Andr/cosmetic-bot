APP_ENV=production
PUBLIC_BASE_URL=https://romanandr.ru
DATABASE_URL=postgresql+asyncpg://cosmetic:replace-me@postgres:5432/cosmetic
REDIS_URL=redis://:replace-me@redis:6379/0

POSTGRES_DB=cosmetic
POSTGRES_USER=cosmetic
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

DOMAIN=romanandr.ru
ACME_EMAIL=operator@example.com

BOT_TOKEN=replace-me
OWNER_TELEGRAM_ID=replace-me
WEBHOOK_SECRET=replace-me
LOYALTY_CODE_PEPPER=replace-me
# This host sits behind Russian network filtering: Telegram cannot open inbound
# webhook connections to it, so long-polling is the only mode that works here.
# Do not switch to "webhook" unless the network path changes.
TELEGRAM_MODE=polling
TELEGRAM_PROXY_URL=socks5://hysteria:1080

# Operational alerts (stale backup, low disk, degraded dependencies) are delivered
# to this Telegram chat; defaults to OWNER_TELEGRAM_ID when left blank.
ALERT_TELEGRAM_ID=769517888
MONITOR_INTERVAL_SECONDS=900
DISK_ALERT_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
# Abandoned Telegram sale drafts expire from Redis after this many seconds (3 days).
FSM_TTL_SECONDS=259200

BIRTHDAY_CASHBACK_PERCENT=10
BIRTHDAY_CASHBACK_WINDOW_DAYS=3

GOOGLE_SHEETS_CREDENTIALS_FILE=/run/secrets/google-service-account.json
GOOGLE_SHEET_NAME=products
PRODUCT_SYNC_INTERVAL_SECONDS=3600
