# Application
APP_ENV=production
PUBLIC_BASE_URL=https://romanandr.ru
DATABASE_URL=postgresql+asyncpg://cosmetic:change-me@postgres:5432/cosmetic
REDIS_URL=redis://:change-me@redis:6379/0

# Database and cache containers
POSTGRES_DB=cosmetic
POSTGRES_USER=cosmetic
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# TLS certificate notifications
DOMAIN=romanandr.ru
ACME_EMAIL=admin@romanandr.ru

# Telegram
BOT_TOKEN=
OWNER_TELEGRAM_ID=
WEBHOOK_SECRET=
LOYALTY_CODE_PEPPER=
TELEGRAM_MODE=webhook

# Google Sheets catalogue
GOOGLE_SHEETS_CREDENTIALS_FILE=/run/secrets/google-service-account.json
GOOGLE_SHEETS_CREDENTIALS_FILE_HOST=./google-service-account.json
GOOGLE_SHEET_NAME=products
PRODUCT_SYNC_INTERVAL_SECONDS=3600
